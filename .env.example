# Anthropic API Key (for LLM agent reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# IBM Quantum Credentials
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_CHANNEL=ibm_quantum

# OpenAI API Key (alternative to Anthropic — set one or the other)
# OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Settings
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8765

# Default backend: "aer_simulator" or an IBM Quantum backend name (e.g. "ibm_brisbane")
DEFAULT_BACKEND=aer_simulator

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
